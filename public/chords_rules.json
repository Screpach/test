{
  "id": "mode-dependent-harmonic-transition-grammar",
  "name": "Mode-Dependent Harmonic Transition Grammar",
  "description": "A scientific musicological progression table for major and minor tonal systems. Roman numerals are treated as scale-degree chord locations, not as case-sensitive indicators of chord quality.",
  "notationPolicy": {
    "caseSensitiveRomanNumerals": false,
    "capitalizationMeaning": "None. I, II, III, IV, V, VI, VII are abstract scale-degree chord labels only.",
    "modeDeterminesQuality": true,
    "qualityEncoding": "Chord quality must be supplied by mode or by explicit suffixes such as dim, dim7, +, 7, M7, m7, or inversion labels.",
    "importantDistinctions": [
      {
        "symbol": "VII6",
        "meaning": "Leading-tone-function chord in first inversion",
        "mustNotBeConfusedWith": "bVII"
      },
      {
        "symbol": "bVII",
        "meaning": "Lowered seventh-degree chord; subtonic or modal/Aeolian function",
        "mustNotBeConfusedWith": "VII6"
      },
      {
        "symbol": "III+6",
        "meaning": "First-inversion augmented mediant sonority in strict harmonic minor",
        "mustNotBeConfusedWith": "III from natural/common minor"
      },
      {
        "symbol": "V64",
        "meaning": "Dominant-function second-inversion sonority in this CHORD encoding system",
        "note": "In conventional Roman-numeral theory, cadential six-four is often analyzed as I64-V-I or CAD64-V-I."
      }
    ]
  },
