  "corrections": [
    {
      "id": "path-vs-direct-transition",
      "issue": "Original rows mix direct transitions and multi-chord paths.",
      "correction": "Interpret rows such as I IV V as I → IV → V, where IV is the immediate successor and V is the continuation."
    },
    {
      "id": "duplicate-major-row",
      "issue": "The original major list repeated II VI V.",
      "correction": "Keep II → VI → V only once."
    },
    {
      "id": "minor-III6-clarification",
      "issue": "Minor III6 is ambiguous.",
      "correction": "Use III+6 for strict harmonic minor; use III for common/natural minor."
    },
    {
      "id": "VII6-vs-bVII",
      "issue": "Leading-tone VII6 and subtonic bVII can be confused.",
      "correction": "Keep VII6 and bVII as separate harmonic entities."
    },
    {
      "id": "V64-definition",
      "issue": "V64 may conflict with conventional cadential six-four notation.",
      "correction": "Define V64 explicitly as dominant-function second-inversion sonority in CHORD, or replace with CAD64 where appropriate."
    }
  ],
  "implementationNotes": [
    "Do not infer chord quality from uppercase or lowercase Roman numerals.",
    "Mode determines default quality.",
    "Use accidentals such as bVII and bVI explicitly.",
    "Use VII6 only for leading-tone-function sonorities.",
    "Use bVII only for subtonic/modal/Aeolian sonorities.",
    "Keep strict harmonic minor and common expanded minor as related but separate layers.",
    "Cadential and circle-of-fifths paths should receive higher priority than connective or optional chromatic paths.",
    "Chromatic and applied chords should be treated as optional expansions, not as ordinary diatonic successors."
  ]
}